(* Generated by plc/st_to_scl.py from the ST source in plc/st. Do not edit:
   change the ST source and regenerate. Not compiled in CI (no TIA Portal there).
   Import in TIA Portal: External source files > Add new external file >
   Generate blocks from source. *)

(*
  MOUNT_CELL: cell controller for mounting one bearing on an alternator rotor shaft.
  IEC 61131-3 Structured Text, compiled with matiec (iec2c) and run once per scan in the closed-loop cell model
  (mount/plant.py). The robot program robot/BRG_MOUNT.ls is the other side of the handshake (signal list in
  robot/io_map.yaml, checked by tests/test_interfaces.py).

  Methods (rcMethod)
    0  HOT_ROBOT   induction heating to shaft + rcDeltaT, robot transfer, slide-on, robot holds until locked
    1  HOT_CLAMP   as 0, but a hold-down clamp holds the ring; the robot is released at once
    2  PRESS       servo press, force-displacement window (cold, or warm-assisted with rcDeltaT > 0)

  Physics-derived recipe limits (from the transient model, DOSSIER §6):
    rcTtrMax   longest allowed time from lifting the bearing off the heater to the start of the slide-on.
               Longer: the radial gap at the seat falls below the margin -> return to the heater, re-heat.
    rcHoldS    time the ring must be held against the shoulder until it has gripped over its full width.
  Press window (DOSSIER §7): force at x1 and x2 inside [lo, hi] from the fit tolerance and friction range,
  seat detected as a force rise of rcFSeatRise kN within rcPosTol of the seat position.
*)

FUNCTION_BLOCK "MOUNT_CELL"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
  cycleTime : REAL;          (* s *)
  cmdStart : BOOL;
  cmdReset : BOOL;
  safetyOk : BOOL;           (* light curtain + e-stop chain *)
  (* heater *)
  mTBearing : REAL;          (* inner-ring temperature, contact probe of the heater, C *)
  mTShaft : REAL;            (* shaft seat temperature, C *)
  (* robot -> PLC *)
  rbReady : BOOL;
  rbPicked : BOOL;           (* bearing lifted off the heater *)
  rbAtShaft : BOOL;          (* at the start of the seat, ready to slide on *)
  rbSeated : BOOL;           (* face at the shoulder (skip condition reached) *)
  rbReleased : BOOL;
  rbReturned : BOOL;         (* bearing put back on the heater after an abort *)
  (* clamp and press *)
  mClampClosed : BOOL;
  mPressPos : REAL;          (* mm of engagement from the seat start *)
  mPressForce : REAL;        (* kN *)
  mPressDone : BOOL;
  (* recipe *)
  rcMethod : INT;
  rcDeltaT : REAL;
  rcTMax : REAL;
  rcTtrMax : REAL;
  rcInsertMax : REAL;
  rcHoldS : REAL;
  rcMaxReheats : INT;
  rcX1 : REAL;
  rcX2 : REAL;
  rcF1Lo : REAL;
  rcF1Hi : REAL;
  rcF2Lo : REAL;
  rcF2Hi : REAL;
  rcFSeatRise : REAL;
  rcSeatPos : REAL;
  rcPosTol : REAL;
  rcFMax : REAL;
END_VAR
VAR_OUTPUT
  qHeaterOn : BOOL;
  qRbPick : BOOL;            (* PLC -> robot: bearing ready, pick it *)
  qRbInsert : BOOL;          (* slide on *)
  qRbRelease : BOOL;
  qRbAbort : BOOL;           (* put the bearing back on the heater *)
  qClamp : BOOL;
  qPressGo : BOOL;
  state : INT;
  verdict : INT;             (* 0 none, 1 OK, 2 NOK *)
  nokCode : INT;
  tTransfer : REAL;
  tHold : REAL;
  reheats : INT;
  fAtX1 : REAL;
  fAtX2 : REAL;
  fMaxSeen : REAL;
  seatPos : REAL;
END_VAR
VAR CONSTANT
  S_IDLE : INT := 0;
  S_HEAT : INT := 1;
  S_PICK : INT := 2;
  S_TRANSFER : INT := 3;
  S_INSERT : INT := 4;
  S_HOLD : INT := 5;
  S_RETURN : INT := 6;
  S_PRESS : INT := 7;
  S_DONE : INT := 8;
  S_FAULT : INT := 9;
  N_TRANSFER_SLOW : INT := 1;
  N_NOT_SEATED : INT := 2;
  N_OVERTEMP : INT := 3;
  N_F1 : INT := 4;
  N_F2 : INT := 5;
  N_NO_SEAT : INT := 6;
  N_FMAX : INT := 7;
  N_REHEATS : INT := 8;
  N_SAFETY : INT := 9;
END_VAR
VAR
  tState : REAL;
  x1Done : BOOL;
  x2Done : BOOL;
  fAtSeatStart : REAL;
END_VAR

BEGIN

  IF #cmdReset AND (#state = #S_DONE OR #state = #S_FAULT OR #state = #S_IDLE) THEN
    #state := #S_IDLE;
    #verdict := 0;
    #nokCode := 0;
  END_IF;

  #tState := #tState + #cycleTime;

  CASE #state OF
    0: (* S_IDLE *)
      IF #cmdStart AND #safetyOk AND #rbReady THEN
        #reheats := 0;
        #verdict := 0;
        #nokCode := 0;
        #tTransfer := 0.0;
        #tHold := 0.0;
        #fAtX1 := 0.0;
        #fAtX2 := 0.0;
        #fMaxSeen := 0.0;
        #x1Done := FALSE;
        #x2Done := FALSE;
        #tState := 0.0;
        IF #rcMethod = 2 AND #rcDeltaT <= 0.0 THEN
          #state := #S_PICK;
        ELSE
          #state := #S_HEAT;
        END_IF;
      END_IF;

    1: (* S_HEAT: to shaft temperature + rcDeltaT, never above rcTMax *)
      IF #mTBearing > #rcTMax THEN
        #nokCode := #N_OVERTEMP;
        #state := #S_FAULT;
      ELSIF #mTBearing >= #mTShaft + #rcDeltaT THEN
        #state := #S_PICK;
        #tState := 0.0;
      END_IF;

    2: (* S_PICK *)
      IF #rbPicked THEN
        #state := #S_TRANSFER;
        #tState := 0.0;
      END_IF;

    3: (* S_TRANSFER: the clock of the cooling ring *)
      #tTransfer := #tState;
      IF #rbAtShaft THEN
        IF #rcMethod = 2 THEN
          #state := #S_PRESS;
        ELSE
          #state := #S_INSERT;
        END_IF;
        #tState := 0.0;
      ELSIF #rcMethod <> 2 AND #tState > #rcTtrMax THEN
        #nokCode := #N_TRANSFER_SLOW;
        #state := #S_RETURN;
        #tState := 0.0;
      END_IF;

    4: (* S_INSERT: slide on until the face reaches the shoulder *)
      IF #rbSeated THEN
        #state := #S_HOLD;
        #tState := 0.0;
      ELSIF #tState > #rcInsertMax THEN
        #nokCode := #N_NOT_SEATED;           (* the ring stopped on the seat: seized *)
        #verdict := 2;
        #state := #S_DONE;
      END_IF;

    5: (* S_HOLD: robot (method 0) or clamp (method 1) holds the ring against the shoulder *)
      #tHold := #tState;
      IF #rcMethod = 1 AND #mClampClosed THEN
        #qRbRelease := TRUE;
      END_IF;
      IF #tState >= #rcHoldS THEN
        #verdict := 1;
        #state := #S_DONE;
      END_IF;

    6: (* S_RETURN: bearing back on the heater, re-heat *)
      IF #rbReturned THEN
        #reheats := #reheats + 1;
        IF #reheats > #rcMaxReheats THEN
          #nokCode := #N_REHEATS;
          #verdict := 2;
          #state := #S_DONE;
        ELSE
          #nokCode := 0;
          #state := #S_HEAT;
        END_IF;
        #tState := 0.0;
      END_IF;

    7: (* S_PRESS: force-displacement window *)
      IF #mPressForce > #fMaxSeen THEN
        #fMaxSeen := #mPressForce;
      END_IF;
      IF NOT #x1Done AND #mPressPos >= #rcX1 THEN
        #fAtX1 := #mPressForce;
        #x1Done := TRUE;
      END_IF;
      IF NOT #x2Done AND #mPressPos >= #rcX2 THEN
        #fAtX2 := #mPressForce;
        #x2Done := TRUE;
      END_IF;
      IF #mPressForce > #rcFMax THEN
        #nokCode := #N_FMAX;
        #verdict := 2;
        #state := #S_DONE;
      ELSIF #mPressDone THEN
        #seatPos := #mPressPos;
        IF #fAtX1 < #rcF1Lo OR #fAtX1 > #rcF1Hi THEN
          #nokCode := #N_F1;
          #verdict := 2;
        ELSIF #fAtX2 < #rcF2Lo OR #fAtX2 > #rcF2Hi THEN
          #nokCode := #N_F2;
          #verdict := 2;
        ELSIF ABS(#mPressPos - #rcSeatPos) > #rcPosTol OR #fMaxSeen < #fAtX2 + #rcFSeatRise THEN
          #nokCode := #N_NO_SEAT;
          #verdict := 2;
        ELSE
          #verdict := 1;
        END_IF;
        #state := #S_DONE;
      END_IF;

  ELSE
    (* S_DONE, S_FAULT: wait for the reset; the output stage below keeps everything safe *)
    #tState := 0.0;
  END_CASE;

  IF NOT #safetyOk AND #state <> #S_IDLE AND #state <> #S_DONE THEN
    #nokCode := #N_SAFETY;
    #state := #S_FAULT;
  END_IF;

  (* output stage: every command follows from the state in the same scan *)
  #qHeaterOn := #state = #S_HEAT;
  #qRbPick := #state = #S_PICK;
  #qRbInsert := #state = #S_INSERT;
  #qRbAbort := #state = #S_RETURN;
  #qClamp := #state = #S_HOLD AND #rcMethod = 1;
  #qPressGo := #state = #S_PRESS;
  IF #state = #S_DONE OR #state = #S_FAULT OR #state = #S_IDLE THEN
    #qRbRelease := #state = #S_DONE;
  ELSIF #state = #S_HOLD THEN
    #qRbRelease := #rcMethod = 1 AND #mClampClosed;
  ELSIF #state = #S_PRESS THEN
    #qRbRelease := TRUE;                    (* the robot leaves the ring on the lead-in, the press takes over *)
  ELSE
    #qRbRelease := FALSE;
  END_IF;


END_FUNCTION_BLOCK
