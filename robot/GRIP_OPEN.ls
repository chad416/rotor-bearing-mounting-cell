/PROG  GRIP_OPEN
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Gripper open";
PROG_SIZE	= 0;
CREATE		= DATE 26-11-10  TIME 12:00:00;
MODIFIED	= DATE 26-11-10  TIME 12:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 3;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  RO[1:GRIP_CLOSE]=OFF ;
   2:  RO[2:GRIP_OPEN]=ON ;
   3:  WAIT RI[2:OPENED]=ON ;
/POS
/END
